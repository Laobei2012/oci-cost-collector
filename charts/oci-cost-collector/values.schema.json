{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tenancyId", "oci", "database", "image", "schedule"],
  "properties": {
    "tenancyId": {
      "type": "string",
      "pattern": "^ocid1\\.tenancy\\.",
      "description": "The OCID of the tenancy whose cost reports the collector loads."
    },
    "account": { "type": "string" },
    "oci": {
      "type": "object",
      "required": ["auth"],
      "properties": {
        "auth": { "enum": ["instance_principal", "resource_principal", "config_file"] },
        "region": { "type": "string" },
        "configSecret": { "type": "string" },
        "profile": { "type": "string" }
      },
      "if": { "properties": { "auth": { "const": "config_file" } } },
      "then": {
        "properties": { "configSecret": { "minLength": 1 } },
        "required": ["configSecret"]
      }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "uriKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "uriKey": { "type": "string", "minLength": 1 }
      }
    },
    "readRoles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "since": { "type": "string" },
    "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "schedule": { "type": "string", "minLength": 1 },
    "timeZone": { "type": "string" },
    "suspend": { "type": "boolean" },
    "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
    "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
    "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podLabels": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "extraEnv": { "type": "array" }
  }
}
